              "value": "{{bearer_token}}",
              "type": "string"
            }
          ]
        },
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Acme Corporation Updated\",\n  \"description\": \"An even more awesome company\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/companies/comp-001",
